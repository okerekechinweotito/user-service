# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=userservice
DATABASE_URL=postgresql://postgres:change_this_password@postgres:5432/userservice

# RabbitMQ (external notification-system network)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_this_password
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://admin:change_this_password@rabbitmq:5672/%2F

# JWT Secrets - GENERATE SECURE RANDOM STRINGS FOR PRODUCTION!
# You can use: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_random_string
REFRESH_TOKEN_SECRET=change_this_to_a_secure_random_string

# Application
NODE_ENV=development
PORT=3000
